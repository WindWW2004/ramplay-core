{
  "name": "ramplay-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "RamPlay Core: the system under every RamPlay platform. A W65C02S 8-bit teaching console (CPU, VIA, cartridge, display protocol) for a browser or Node.",
  "keywords": [
    "6502",
    "65c02",
    "emulator",
    "8-bit",
    "teaching",
    "fantasy-console",
    "retro"
  ],
  "homepage": "https://ramplay.socialshields.org/core/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihozh/ramplay-core.git"
  },
  "bugs": "https://github.com/ihozh/ramplay-core/issues",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "ramplay-source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lib": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "assets": "node scripts/assets.mjs",
    "dev": "node scripts/assets.mjs && vite",
    "build": "node scripts/assets.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsc -p tsconfig.build.json && node --test test/*.test.ts",
    "frame": "node scripts/frame.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
